[Unit]
# Starts unconditionally at boot (binds 0.0.0.0:8080, no connectivity needed)
# so the /wifi-setup captive portal is available while in AP mode.
Description=Smart Speaker API Server
After=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/iot-proj/IOT-project--Smart-Speaker/Main
ExecStart=/home/iot-proj/IOT-project--Smart-Speaker/venv/bin/python server_main.py
Restart=always
RestartSec=5

# Logging
StandardOutput=append:/var/log/smart_speaker_server.log
StandardError=append:/var/log/smart_speaker_server.log

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
