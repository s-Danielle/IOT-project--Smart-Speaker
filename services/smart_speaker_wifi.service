[Unit]
# Boot-time connectivity check with AP-mode fallback. Binds no ports;
# the setup portal is served by the main server (smart_speaker_server).
Description=Smart Speaker WiFi Provisioner
After=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/iot-proj/IOT-project--Smart-Speaker/Main
ExecStart=/home/iot-proj/IOT-project--Smart-Speaker/venv/bin/python wifi_provisioner.py
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=append:/var/log/smart_speaker_wifi.log
StandardError=append:/var/log/smart_speaker_wifi.log

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
